---
import Default from '@astrojs/starlight/components/LanguageSelect.astro';

// The chart set manual has no English version: from its pages the language
// control leads to the English home page instead of a page that does not exist.
const isManual = Astro.url.pathname.startsWith('/developers/chartset/');
---

{
	isManual ? (
		<a class="language-link" href="/en/" lang="en">
			English
		</a>
	) : (
		<Default />
	)
}

<style>
	.language-link {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.language-link:hover {
		color: var(--sl-color-white);
	}
</style>
